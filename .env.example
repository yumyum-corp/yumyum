# Copy to .env for Docker Compose. Never commit actual credentials.
# Compose must explicitly map these values into each service (deployment step 3).

# MySQL: DB_USERNAME/DB_PASSWORD also provision the non-root MySQL account.
MYSQL_DATABASE=yumyum
DB_USERNAME=nyamnyam
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://mysql:3306/yumyum?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# Spring deployment profile. Fresh disposable demo DB only: temporarily use update.
# Existing/real data: validate; provision schema before starting the app.
SPRING_PROFILES_ACTIVE=prod
DB_DDL_AUTO=validate
JWT_SECRET=
REDIS_HOST=redis
REDIS_PORT=6379
AI_FASTAPI_URL=http://ai:8000
FOOD_API_KEY=

# Replace example.com with the deployment domain; callback includes /api.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.com/api/login/oauth2/code/kakao
FRONTEND_REDIRECT_URL=https://example.com/oauth/callback
CORS_ALLOWED_ORIGINS=https://example.com

# AI: dev returns mock AI responses; prod requires a valid GMS key.
ENV=dev
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
DEFAULT_MODEL=claude-haiku-4-5-20251001
MFDS_API_KEY=
# Reserved setting: currently no AI call site uses this value.
SPRING_BASE_URL=http://backend:8080

# Public frontend build value; never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
